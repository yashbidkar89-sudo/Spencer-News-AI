# =========================================================
# Chris News AI — Financial News Simplifier Environment Variables
# =========================================================

# NewsAPI Key: Get a free API key from https://newsapi.org/
NEWS_API_KEY="your_newsapi_key_here"

# Groq API Key: Get a free API key from https://console.groq.com/
GROQ_API_KEY="your_groq_api_key_here"

# Model selection for Groq (default: llama-3.3-70b-versatile)
GROQ_MODEL="llama-3.3-70b-versatile"

# Optional GEMINI_API_KEY if using Gemini as secondary/alternative AI provider
GEMINI_API_KEY=""

# Application Host / Port Configurations
PORT=3000
HOST="0.0.0.0"
APP_URL="http://localhost:3000"
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

