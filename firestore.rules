rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Global helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // User profile validation
    function isValidUser(data) {
      return data.uid is string &&
             data.uid == request.auth.uid &&
             data.email is string &&
             data.email.size() <= 256;
    }

    // Saved article validation
    function isValidSavedArticle(data) {
      return data.id is string &&
             data.userId is string &&
             data.userId == request.auth.uid &&
             data.title is string &&
             data.title.size() <= 500 &&
             data.simpleSummary is string &&
             data.simpleSummary.size() <= 2000;
    }

    // Users collection
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming()) && incoming().uid == existing().uid;
      allow delete: if isOwner(userId);

      // Subcollection: Saved Articles
      match /saved_articles/{articleId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidSavedArticle(incoming());
        allow update: if isOwner(userId) && isValidSavedArticle(incoming()) && incoming().userId == existing().userId;
        allow delete: if isOwner(userId);
      }
    }
  }
}
