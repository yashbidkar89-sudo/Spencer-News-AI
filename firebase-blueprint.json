{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "SavedArticle": {
      "title": "SavedArticle",
      "description": "A financial news article bookmarked by a user",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string", "maxLength": 500 },
        "source": { "type": "string", "maxLength": 100 },
        "category": { "type": "string", "maxLength": 100 },
        "simpleSummary": { "type": "string", "maxLength": 2000 },
        "url": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "title", "simpleSummary"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile documents"
    },
    "/users/{userId}/saved_articles/{articleId}": {
      "schema": "SavedArticle",
      "description": "User saved and bookmarked financial news articles"
    }
  }
}
